{
  "name": "codex-notification-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist work/test-dist",
    "build": "npm run clean && npm run bundle",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js && esbuild src/hook.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/hook.js",
    "test": "rm -rf work/test-dist && tsc -p tsconfig.test.json && node --test work/test-dist/test/**/*.test.js",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit -p tsconfig.json",
    "validate:release": "node scripts/validate-release.mjs",
    "check": "npm test && npm run lint && npm run format:check && npm run validate:release",
    "validate:plugin": "python3 /Users/ww/.codex/skills/.system/plugin-creator/scripts/validate_plugin.py .",
    "validate:skill": "python3 /Users/ww/.codex/skills/.system/skill-creator/scripts/quick_validate.py skills/notification-policy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
